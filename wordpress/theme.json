{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "1400px",
			"wideSize": "1400px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"link": true,
			"palette": [
				{ "slug": "white",      "color": "#ffffff", "name": "White" },
				{ "slug": "cc-light",   "color": "#f6f6f6", "name": "Light Grey" },
				{ "slug": "cc-tint",    "color": "#f0f4f2", "name": "Sage Tint" },
				{ "slug": "cc-dark",    "color": "#466359", "name": "Brand Green" },
				{ "slug": "cc-deep",    "color": "#2a3b35", "name": "Deep Green" },
				{ "slug": "cc-sage",    "color": "#6a9082", "name": "Sage" },
				{ "slug": "cc-sage-ada","color": "#567569", "name": "Sage (Accessible Text)" },
				{ "slug": "cc-orange",  "color": "#f36334", "name": "Accent Orange" },
				{ "slug": "cc-orange-ada", "color": "#bb4c28", "name": "Accent Orange (Accessible Text)" },
				{ "slug": "cc-muted",   "color": "#666666", "name": "Muted Text" },
				{ "slug": "cc-faint",   "color": "#767676", "name": "Faint Text" },
				{ "slug": "cc-hairline","color": "#e5e7eb", "name": "Hairline" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": false,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "montserrat",
					"name": "Montserrat",
					"fontFamily": "Montserrat, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Montserrat", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-var.woff2" ] }
					]
				},
				{
					"slug": "cormorant",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", \"Times New Roman\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "300 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-var.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "300 700", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-var-italic.woff2" ] }
					]
				},
				{
					"slug": "helvetica",
					"name": "Helvetica Neue",
					"fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "eyebrow",   "name": "Eyebrow (11)",       "size": "11px" },
				{ "slug": "btn-sm",    "name": "Button Small (12)",  "size": "12px" },
				{ "slug": "btn",       "name": "Button (13)",        "size": "13px" },
				{ "slug": "body",      "name": "Body (15)",          "size": "15px" },
				{ "slug": "body-lg",   "name": "Body Large",         "size": "clamp(14px, 1.1vw, 17px)" },
				{ "slug": "lead",      "name": "Lead",               "size": "clamp(16px, 1.3vw, 18.72px)" },
				{ "slug": "quote",     "name": "Serif Quote",        "size": "clamp(24px, 2.22vw, 32px)" },
				{ "slug": "card-sm",   "name": "Card Title Small",   "size": "22px" },
				{ "slug": "card",      "name": "Card Title",         "size": "clamp(20px, 1.8vw, 26px)" },
				{ "slug": "h2-feature","name": "Feature Heading",    "size": "clamp(32px, 3.05vw, 44px)" },
				{ "slug": "h2",        "name": "Section Heading",    "size": "clamp(32px, 4.5vw, 56px)" },
				{ "slug": "h2-lg",     "name": "Large Heading",      "size": "clamp(36px, 4.45vw, 64px)" },
				{ "slug": "h1",        "name": "Hero Heading",       "size": "clamp(36px, 5.5vw, 80px)" },
				{ "slug": "display",   "name": "Serif Display",      "size": "clamp(36px, 7vw, 96px)" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"customSpacingSize": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1 — Hairline",  "size": "2px" },
				{ "slug": "20", "name": "2 — 4",         "size": "4px" },
				{ "slug": "30", "name": "3 — 8",         "size": "8px" },
				{ "slug": "40", "name": "4 — 12",        "size": "12px" },
				{ "slug": "50", "name": "5 — 16",        "size": "16px" },
				{ "slug": "60", "name": "6 — 20",        "size": "20px" },
				{ "slug": "70", "name": "7 — 24",        "size": "24px" },
				{ "slug": "80", "name": "8 — 32",        "size": "32px" },
				{ "slug": "90", "name": "9 — 40",        "size": "40px" },
				{ "slug": "100","name": "10 — 48",       "size": "48px" },
				{ "slug": "110","name": "11 — 56",       "size": "56px" },
				{ "slug": "120","name": "12 — 64",       "size": "64px" },
				{ "slug": "130","name": "13 — 80",       "size": "clamp(48px, 5.5vw, 80px)" },
				{ "slug": "140","name": "14 — Section Tight",  "size": "clamp(64px, 8.3vw, 120px)" },
				{ "slug": "150","name": "15 — Section",        "size": "clamp(72px, 9.7vw, 140px)" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false },
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--cc-dark)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--helvetica)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "0px",
			"padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--cc-orange-ada)" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontWeight": "300"
				},
				"color": { "text": "var(--wp--preset--color--cc-dark)" }
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h1)",
					"fontWeight": "400",
					"lineHeight": "1.05",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h2)",
					"fontWeight": "300",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--card)",
					"fontWeight": "300",
					"lineHeight": "1.25",
					"letterSpacing": "-0.02em"
				},
				"color": { "text": "var(--wp--preset--color--cc-deep)" }
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--card-sm)",
					"fontWeight": "500",
					"lineHeight": "1.3",
					"letterSpacing": "-0.01em"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--helvetica)",
					"fontSize": "var(--wp--preset--font-size--btn)",
					"fontWeight": "500",
					"lineHeight": "1.6",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--helvetica)",
					"fontSize": "var(--wp--preset--font-size--eyebrow)",
					"fontWeight": "500",
					"lineHeight": "1.6",
					"letterSpacing": "0.24em",
					"textTransform": "uppercase"
				},
				"color": { "text": "var(--wp--preset--color--cc-sage)" }
			},
			"button": {
				"border": { "radius": "0px", "width": "2px", "style": "solid", "color": "var(--wp--preset--color--cc-orange-ada)" },
				"color": { "background": "var(--wp--preset--color--cc-orange-ada)", "text": "var(--wp--preset--color--white)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--helvetica)",
					"fontSize": "var(--wp--preset--font-size--btn)",
					"fontWeight": "500",
					"lineHeight": "1",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				},
				"spacing": { "padding": { "top": "16px", "right": "40px", "bottom": "16px", "left": "40px" } },
				":hover": {
					"color": { "background": "#a8431f", "text": "var(--wp--preset--color--white)" },
					"border": { "color": "#a8431f" }
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": { "lineHeight": "1.6" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--cc-hairline)" }
			},
			"core/image": {
				"border": { "radius": "0px" }
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cormorant)",
					"fontSize": "var(--wp--preset--font-size--quote)",
					"fontWeight": "400"
				}
			}
		}
	},
	"customTemplates": [
		{ "name": "page-legacy", "title": "Legacy Page (orbdust shell)", "postTypes": [ "page", "post" ] },
		{ "name": "page-full",   "title": "Full Width (no title)",      "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header",        "title": "Header",                "area": "header" },
		{ "name": "header-legacy", "title": "Header (Legacy)",       "area": "header" },
		{ "name": "footer",        "title": "Footer",                "area": "footer" },
		{ "name": "footer-legacy", "title": "Footer (Legacy)",       "area": "footer" }
	]
}
